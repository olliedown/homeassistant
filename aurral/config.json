{
  "name": "Aurral",
  "version": "1.0.0",
  "slug": "aurral",
  "description": "Aurral music service",
  "arch": ["aarch64", "amd64", "armv7"],

  "build": "aurral",
  "startup": "application",
  "init": false,

  "map": [
    "data:rw",
    "share:rw"
  ],

  "ports": {
    "3001/tcp": 3001
  },
  "ports_description": {
    "3001/tcp": "Web interface"
  },

  "environment": {
    "DOWNLOAD_FOLDER": "/share/aurraldownloads",
    "PUID": "0",
    "PGID": "0"
  },

  "options": {
    "PUID": 0,
    "PGID": 0
  },

  "schema": {
    "PUID": "int",
    "PGID": "int"
  },

  "webui": "[PROTO:ssl]://[PORT:3001]",
  "url": "https://github.com/olliedown/homeassistant/tree/main/aurral"
}
